[Unit]
Description=Tera Claw painel (a tela do dono do agente)
After=network.target
# O painel.env é gerado pelo "teraclaw agente criar". Sem ele a unidade fica quieta.
ConditionPathExists=/run/teraclaw/config/painel.env

[Service]
Type=simple
User=agente
EnvironmentFile=/run/teraclaw/config/painel.env
WorkingDirectory=/opt/teraclaw/app/panel
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
