[Unit]
Description=Tera Claw ponte do WhatsApp (liga o numero secundario do dono ao agente pelo Baileys)
After=network-online.target teraclaw-runner.service
Wants=network-online.target
# Esta unidade vem na imagem mas NAO e habilitada nela: quem liga e o dono, com
# "teraclaw-agente canal whatsapp ligar", que cria o arquivo "ligado" e roda o enable.
# O ConditionPathExists segura a subida: sem o arquivo (WhatsApp nunca ligado, ou desligado
# de proposito) a unidade fica quieta em vez de falhar a cada boot.
ConditionPathExists=/home/agente/.teraclaw/whatsapp/ligado

[Service]
Type=simple
User=agente
Environment=HOME=/home/agente
Environment=TERACLAW_RUNNER_URL=http://127.0.0.1:4300
Environment=RUNNER_TOKEN_FILE=/run/teraclaw/segredos/runner.token
Environment=TERACLAW_RUNNER_JSON=/etc/teraclaw-runner/runner.json
# Nada que a ponte crie (sessao, socket, log) fica legivel para grupo ou outros.
UMask=0077
NoNewPrivileges=yes
WorkingDirectory=/opt/teraclaw/app/canais/whatsapp
ExecStart=/usr/bin/node /opt/teraclaw/app/canais/whatsapp/ponte.mjs
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
